    <Placemark>
      <name>✈️ שדה תעופה סאן אנדרס (ADZ)</name>
      <description><![CDATA[✈️ <b>תחבורה / מעבר</b><br/>נחיתה באי – 5 דק׳ מהמרכז.<br/><a href="https://www.google.com/maps/search/?api=1&query=Gustavo%20Rojas%20Pinilla%20International%20Airport%2C%20San%20Andr%C3%A9s">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#transport</styleUrl>
      <Point><coordinates>-81.7112,12.5836,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 חוף Spratt Bight</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>החוף הראשי מול ׳ים שבעת הצבעים׳.<br/><a href="https://www.google.com/maps/search/?api=1&query=Spratt%20Bight%20Beach%2C%20San%20Andr%C3%A9s">פתיחה ב-Google Maps</a>]]></description>
