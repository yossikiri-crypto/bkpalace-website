<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>🇧🇷 2. האי איליה גרנדה (Ilha Grande) | ימים 3–5</name>
    <Style id="attraction">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/green-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="nightlife">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/purple-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotel">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/blue-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="transport">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/yellow-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="route">
      <LineStyle><color>ccF27221</color><width>4</width></LineStyle>
    </Style>
    <Placemark>
      <name>✈️ נמל Conceição de Jacareí</name>
      <description><![CDATA[✈️ <b>תחבורה / מעבר</b><br/>נקודת היציאה של הסירות המהירות לאיליה גרנדה (כ-20 דק&#x27;).<br/><a href="https://www.google.com/maps/search/?api=1&query=Concei%C3%A7%C3%A3o%20de%20Jacare%C3%AD%2C%20Mangaratiba">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#transport</styleUrl>
      <Point><coordinates>-44.466,-23.014,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Vila do Abraão – הכפר הראשי</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>הכפר הראשי של האי – בסיס הלינה, המסעדות והסירות.<br/><a href="https://www.google.com/maps/search/?api=1&query=Vila%20do%20Abra%C3%A3o%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.1699,-23.1394,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 חוף Lopes Mendes</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>טרק של כ-2.5 שעות בג&#x27;ונגל מ-Abraão לאחד החופים היפים בברזיל.<br/><a href="https://www.google.com/maps/search/?api=1&query=Praia%20de%20Lopes%20Mendes%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.123,-23.1636,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Lagoa Azul – הלגונה הכחולה</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>עצירת שנורקול בשיט Volta a Ilha ללגונות הטורקיז.<br/><a href="https://www.google.com/maps/search/?api=1&query=Lagoa%20Azul%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.2378,-23.0797,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🍻 חוף Abraão – מסיבות Forró ומדורות</name>
      <description><![CDATA[🍻 <b>ברים וחיי לילה</b><br/>מסיבות Forró על קו המים ומדורות בחוף בלילה.<br/><a href="https://www.google.com/maps/search/?api=1&query=Praia%20do%20Abra%C3%A3o%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#nightlife</styleUrl>
      <Point><coordinates>-44.1695,-23.1385,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Pousada Naturalia (בוטיק)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>פוסאדת בוטיק על החוף ב-Vila do Abraão.<br/><a href="https://www.google.com/maps/search/?api=1&query=Pousada%20Naturalia%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-44.172,-23.14,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Che Lagarto Hostel (הוסטל)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>הוסטל ברמה גבוהה במרכז Abraão.<br/><a href="https://www.google.com/maps/search/?api=1&query=Che%20Lagarto%20Hostel%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-44.168,-23.1397,0</coordinates></Point>
    </Placemark>
  </Document>
</kml>
