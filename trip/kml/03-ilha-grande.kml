<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>🏝️ 3. איליה גרנדה – ג&#x27;ונגל, טרקים ואיזון | ימים 8–11 · ב׳–ה׳ 8–11.2.2027</name>
    <Style id="attraction">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/green-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="nightlife">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/purple-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotel">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/blue-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="transport">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/yellow-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="route">
      <LineStyle><color>ccF27221</color><width>4</width></LineStyle>
    </Style>
    <Placemark>
      <name>✈️ נמל Conceição de Jacareí</name>
      <description><![CDATA[✈️ <b>תחבורה / מעבר</b><br/>נקודת היציאה של הסירות המהירות לאי (כ-20 דק׳).<br/><a href="https://www.google.com/maps/search/?api=1&query=Concei%C3%A7%C3%A3o%20de%20Jacare%C3%AD%2C%20Mangaratiba">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#transport</styleUrl>
      <Point><coordinates>-44.466,-23.014,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Vila do Abraão</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>הכפר הראשי – בסיס הלינה, המסעדות והסירות.<br/><a href="https://www.google.com/maps/search/?api=1&query=Vila%20do%20Abra%C3%A3o%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.1699,-23.1394,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 חוף Lopes Mendes</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>מהחופים היפים בעולם – שייט + הליכה קצרה בג׳ונגל. יום ג׳ 9.2.<br/><a href="https://www.google.com/maps/search/?api=1&query=Praia%20de%20Lopes%20Mendes%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.123,-23.1636,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 טרק Pico do Papagaio</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>טרק זריחה לפסגה בגובה 982 מ׳ – יציאה 2:00 לפנות בוקר עם מדריך. ד׳ 10.2.<br/><a href="https://www.google.com/maps/search/?api=1&query=Pico%20do%20Papagaio%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.199,-23.1547,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Lagoa Azul – הלגונה הכחולה</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>שנורקלינג במים טורקיז – אחה״צ של יום הזריחה.<br/><a href="https://www.google.com/maps/search/?api=1&query=Lagoa%20Azul%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-44.2378,-23.0797,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🍻 חוף Abraão – ערבי Forró</name>
      <description><![CDATA[🍻 <b>ברים וחיי לילה</b><br/>מוזיקה חיה ומדורות על קו המים בלילה.<br/><a href="https://www.google.com/maps/search/?api=1&query=Praia%20do%20Abra%C3%A3o%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#nightlife</styleUrl>
      <Point><coordinates>-44.1695,-23.1385,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Pousada Naturalia (בוטיק)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>פוסאדת בוטיק על החוף.<br/><a href="https://www.google.com/maps/search/?api=1&query=Pousada%20Naturalia%2C%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-44.172,-23.14,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Che Lagarto Hostel (הוסטל)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>הוסטל ברמה גבוהה במרכז הכפר.<br/><a href="https://www.google.com/maps/search/?api=1&query=Che%20Lagarto%20Hostel%20Ilha%20Grande">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-44.168,-23.1397,0</coordinates></Point>
    </Placemark>
  </Document>
