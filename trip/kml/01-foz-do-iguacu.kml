<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>🇧🇷 1. מפלי איגואסו (Foz do Iguaçu) | ימים 1–2</name>
    <Style id="attraction">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/green-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="nightlife">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/purple-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotel">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/blue-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="transport">
      <IconStyle><Icon><href>http://maps.google.com/mapfiles/ms/icons/yellow-dot.png</href></Icon></IconStyle>
    </Style>
    <Style id="route">
      <LineStyle><color>ccF27221</color><width>4</width></LineStyle>
    </Style>
    <Placemark>
      <name>✈️ שדה התעופה פוס דו איגואסו (IGU)</name>
      <description><![CDATA[✈️ <b>תחבורה / מעבר</b><br/>נקודת הנחיתה הבינלאומית לתחילת הטיול.<br/><a href="https://www.google.com/maps/search/?api=1&query=Foz%20do%20Igua%C3%A7u%20International%20Airport">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#transport</styleUrl>
      <Point><coordinates>-54.485,-25.5996,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 מפלי איגואסו – הצד הברזילאי</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>המסלול הברזילאי של המפלים – התצפיות הפנורמיות הגדולות.<br/><a href="https://www.google.com/maps/search/?api=1&query=Cataratas%20do%20Igua%C3%A7u%2C%20Parque%20Nacional%20do%20Igua%C3%A7u%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-54.4367,-25.6953,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Macuco Safari – שיט מתחת למפלים</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>שיט סירת מנוע אל מתחת למפלים. להביא בגדים להחלפה!<br/><a href="https://www.google.com/maps/search/?api=1&query=Macuco%20Safari%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-54.45,-25.6667,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥾 Parque das Aves – פארק הציפורים</name>
      <description><![CDATA[🥾 <b>אטרקציה / טרק</b><br/>פארק ציפורים טרופי מול הכניסה לפארק הלאומי.<br/><a href="https://www.google.com/maps/search/?api=1&query=Parque%20das%20Aves%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#attraction</styleUrl>
      <Point><coordinates>-54.4829,-25.6129,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🍻 Rafain Churrascaria – מופע פולקלור</name>
      <description><![CDATA[🍻 <b>ברים וחיי לילה</b><br/>ארוחת בשרים ומופע פולקלור דרום-אמריקאי.<br/><a href="https://www.google.com/maps/search/?api=1&query=Rafain%20Churrascaria%20Show%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#nightlife</styleUrl>
      <Point><coordinates>-54.545,-25.5754,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Belmond Hotel das Cataratas (בוטיק/יוקרה)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>המלון היחיד בתוך הפארק הלאומי – גישה למפלים לפני כולם.<br/><a href="https://www.google.com/maps/search/?api=1&query=Belmond%20Hotel%20das%20Cataratas%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-54.4419,-25.6903,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Tetris Container Hostel (הוסטל)</name>
      <description><![CDATA[🏨 <b>לינה</b><br/>הוסטל מעוצב ממכולות, ברמה גבוהה.<br/><a href="https://www.google.com/maps/search/?api=1&query=Tetris%20Container%20Hostel%2C%20Foz%20do%20Igua%C3%A7u">פתיחה ב-Google Maps</a>]]></description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>-54.558,-25.5528,0</coordinates></Point>
    </Placemark>
  </Document>
</kml>
